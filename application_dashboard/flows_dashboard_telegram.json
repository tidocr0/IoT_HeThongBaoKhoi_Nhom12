    {
        "id": "fn_telegram_check",
        "type": "function",
        "z": "tab_dashboard_nhom12",
        "name": "Kiểm Tra Ngưỡng Bắn Telegram",
        "func": "var data = msg.payload;\nvar ppm = data.smoke_ppm || 0;\nvar temp = data.temp || 0;\n\nvar lastAlert = context.get('lastAlertTime') || 0;\nvar now = Date.now();\n\nif ((ppm > 600 || temp > 55.0) && (now - lastAlert > 60000)) {\n    context.set('lastAlertTime', now);\n    return msg;\n}\nreturn null;",
