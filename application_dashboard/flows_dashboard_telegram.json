    {
        "id": "fn_split_metrics",
        "type": "function",
        "z": "tab_dashboard_nhom12",
        "name": "Bóc Tách Dữ Liệu Dashboard",
        "func": "var data = msg.payload;\nvar msgPpm = { payload: data.smoke_ppm || 0 };\nvar msgTemp = { payload: data.temp || 0, topic: 'Nhiệt độ (°C)' };\nvar msgHum = { payload: data.hum || 0, topic: 'Độ ẩm (%)' };\nvar msgState = { payload: 'Trạng thái: ' + (data.state || 'UNKNOWN') };\n\nreturn [msgPpm, msgTemp, msgHum, msgState];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 140,
        "wires": [
            [
                "ui_gauge_smoke"
            ],
            [
                "ui_chart_env"
            ],
