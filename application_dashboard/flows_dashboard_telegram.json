    {
        "id": "fn_telegram_fire_alert",
        "type": "function",
        "z": "tab_dashboard_nhom12",
        "name": "Định Dạng Tin Nhắn Telegram",
        "func": "var data = msg.payload;\nvar ppm = data.smoke_ppm || 0;\nvar temp = data.temp || 0;\nvar hum = data.hum || 0;\nvar timeStr = new Date().toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' });\n\nvar CHAT_ID = \"YOUR_TELEGRAM_CHAT_ID\"; // Chat ID cá nhân của Trưởng nhóm Lục Xuân Thịnh\n\nvar messageText = \"🚨 <b>[CẢNH BÁO HỎA HOẠN KHẨN CẤP]</b> 🚨\\n\" +\n                  \"🏢 <b>Địa điểm:</b> Trạm Cảm Biến Nhóm 12 (Đề tài 04)\\n\" +\n                  \"⚠️ <b>Nồng độ khói:</b> <code>\" + ppm + \" PPM</code> (Ngưỡng nguy hiểm > 600)\\n\" +\n                  \"🌡️ <b>Nhiệt độ hiện tại:</b> <code>\" + temp + \" °C</code>\\n\" +\n                  \"💧 <b>Độ ẩm môi trường:</b> <code>\" + hum + \" %</code>\\n\" +\n                  \"🌀 <b>Trạng thái:</b> Quạt hút ĐÃ BẬT TỐI ĐA | Còi ĐANG HÚ\\n\" +\n                  \"⏰ <b>Thời gian ghi nhận:</b> \" + timeStr + \"\\n\\n\" +\n                  \"👉 <i>Vui lòng kiểm tra hiện trường ngay lập tức!</i>\";\n\nvar uiData = {\n    smoke_ppm: ppm,\n    temp: temp,\n    hum: hum,\n    state: \"DANGER\",\n    time: timeStr\n};\n\nreturn [\n    {\n        payload: {\n            chat_id: CHAT_ID,\n            text: messageText,\n            parse_mode: \"HTML\"\n        }\n    },\n    { payload: uiData }\n];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
