    {
        "id": "ui_template_smoke_badge",
        "type": "ui_template",
        "z": "tab_dashboard_nhom12",
        "group": "ui_grp_monitor_smoke",
        "name": "Thẻ Trạng Thái Khói",
        "order": 2,
        "width": 8,
        "height": 3,
        "format": "<div style=\"padding: 10px 14px; border-radius: 10px; border: 1px solid;\"\n     ng-style=\"{\n       'background-color': (msg.payload < 300) ? '#ecfdf5' : ((msg.payload <= 600) ? '#fffbeb' : '#fef2f2'),\n       'border-color': (msg.payload < 300) ? '#a7f3d0' : ((msg.payload <= 600) ? '#fde68a' : '#fecdd3'),\n       'color': (msg.payload < 300) ? '#065f46' : ((msg.payload <= 600) ? '#92400e' : '#991b1b')\n     }\">\n  <div style=\"display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;\">\n    <span style=\"font-weight: 700; font-size: 13px;\">\n      <span ng-if=\"msg.payload < 300\">✅ MÔI TRƯỜNG AN TOÀN</span>\n      <span ng-if=\"msg.payload >= 300 && msg.payload <= 600\">⚠️ CẢNH BÁO: KHÓI TĂNG</span>\n      <span ng-if=\"msg.payload > 600\">🚨 NGUY CƠ HỎA HOẠN!</span>\n    </span>\n    <span style=\"font-weight: 800; font-size: 14px; font-family: monospace;\">{{msg.payload || 0}} PPM</span>\n  </div>\n  <div style=\"font-size: 11px; line-height: 1.4; opacity: 0.95;\">\n    <span ng-if=\"msg.payload < 300\">Nồng độ khói ở mức bình thường (&lt; 300 PPM). Quạt hút ở chế độ chờ.</span>\n    <span ng-if=\"msg.payload >= 300 && msg.payload <= 600\">Phát hiện khí khói tăng bất thường (300 - 600 PPM). Đang theo dõi.</span>\n    <span ng-if=\"msg.payload > 600\">Nồng độ khói vượt ngưỡng (&gt; 600 PPM)! Quạt hút BẬT TỐI ĐA, còi hú và Telegram đã gửi!</span>\n  </div>\n</div>\n",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 720,
        "y": 140,
        "wires": [
            []
        ]
    },
