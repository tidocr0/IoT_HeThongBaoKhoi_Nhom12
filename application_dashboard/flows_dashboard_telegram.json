    {
        "id": "fn_telegram_check",
        "type": "function",
        "z": "tab_dashboard_nhom12",
        "name": "Kiểm Tra Ngưỡng Bắn Telegram",
        "func": "var data = msg.payload;\nvar ppm = data.smoke_ppm || 0;\nvar temp = data.temp || 0;\n\n// Chống spam: chỉ gửi tối đa 1 tin mỗi 60 giây nếu cháy liên tục\nvar lastAlert = context.get('lastAlertTime') || 0;\nvar now = Date.now();\n\nif ((ppm > 600 || temp > 55.0) && (now - lastAlert > 60000)) {\n    context.set('lastAlertTime', now);\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 240,
        "wires": [
            [
                "fn_telegram_fire_alert"
            ]
        ]
    },
    {
        "id": "fn_telegram_fire_alert",
        "type": "function",
        "z": "tab_dashboard_nhom12",
        "name": "Định Dạng Tin Nhắn Telegram",
        "func": "var data = msg.payload;\nvar ppm = data.smoke_ppm || 0;\nvar temp = data.temp || 0;\nvar hum = data.hum || 0;\nvar timeStr = new Date().toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' });\n\n// ĐIỀN CHAT ID CỦA BẠN VÀO DƯỚI ĐÂY:\nvar CHAT_ID = flow.get('TELEGRAM_CHAT_ID') || \"123456789\"; \n\nvar messageText = \"🚨 <b>[CẢNH BÁO HỎA HOẠN KHẨN CẤP]</b> 🚨\\n\" +\n                  \"🏢 <b>Địa điểm:</b> Trạm Cảm Biến Nhóm 12 (Đề tài 04)\\n\" +\n                  \"⚠️ <b>Nồng độ khói:</b> <code>\" + ppm + \" PPM</code> (Ngưỡng nguy hiểm > 600)\\n\" +\n                  \"🌡️ <b>Nhiệt độ hiện tại:</b> <code>\" + temp + \" °C</code>\\n\" +\n                  \"💧 <b>Độ ẩm môi trường:</b> <code>\" + hum + \" %</code>\\n\" +\n                  \"🌀 <b>Trạng thái:</b> Quạt hút ĐÃ BẬT TỐI ĐA | Còi ĐANG HÚ\\n\" +\n                  \"⏰ <b>Thời gian ghi nhận:</b> \" + timeStr + \"\\n\\n\" +\n                  \"👉 <i>Vui lòng kiểm tra hiện trường ngay lập tức!</i>\";\n\nmsg.payload = {\n    chat_id: CHAT_ID,\n    text: messageText,\n    parse_mode: \"HTML\"\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 320,
        "wires": [
            [
                "http_telegram_send",
                "ui_template_alert_log"
            ]
        ]
    },
