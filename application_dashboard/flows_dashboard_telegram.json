    {
        "id": "fn_split_metrics",
        "type": "function",
        "z": "tab_dashboard_nhom12",
        "name": "Bóc Tách Dữ Liệu Dashboard",
        "func": "var data = msg.payload;\nvar ppm = data.smoke_ppm || 0;\nvar temp = data.temp || 0;\nvar hum = data.hum || 0;\n\nvar msgPpm = { payload: ppm };\nvar msgTemp = { payload: temp, topic: 'Nhiệt độ (°C)' };\nvar msgHum = { payload: hum, topic: 'Độ ẩm (%)' };\nvar msgEnvCards = { payload: { temp: temp, hum: hum } };\nvar msgSmokeBadge = { payload: ppm };\n\nreturn [msgPpm, msgTemp, msgHum, msgEnvCards, msgSmokeBadge];\n",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 120,
        "wires": [
            [
                "ui_gauge_smoke"
            ],
            [
                "ui_chart_env"
            ],
            [
                "ui_chart_env"
            ],
            [
                "ui_template_env_cards"
            ],
            [
                "ui_template_smoke_badge"
            ]
        ]
    },
