    {
        "id": "fn_automation_rules",
        "type": "function",
        "z": "tab_fire_alarm",
        "name": "Automation Rule (3 Ngưỡng Khói)",
        "func": "var data = msg.payload;\nvar ppm = data.smoke_ppm || 0;\nvar temp = data.temp || 0;\n\n// 1. Tự động kích hoạt khi có cháy\nif (ppm > 600 || temp > 55.0) {\n    return [\n        { topic: \"nhom12/baokhoi/cmd\", payload: JSON.stringify({ cmd: \"FAN_ON\" }) },\n        { topic: \"nhom12/baokhoi/cmd\", payload: JSON.stringify({ buzzer: 1 }) },\n        { payload: { event: \"FIRE_ALARM\", smoke: ppm, temp: temp, time: new Date().toISOString() } }\n    ];\n} \n// 2. Tự động trả về an toàn khi hết khói\nelse if (ppm < 300) {\n    return [\n        { topic: \"nhom12/baokhoi/cmd\", payload: JSON.stringify({ cmd: \"AUTO\" }) },\n        { topic: \"nhom12/baokhoi/cmd\", payload: JSON.stringify({ buzzer: 0 }) },\n        { payload: { event: \"SAFE\", smoke: ppm, temp: temp, time: new Date().toISOString() } }\n    ];\n}\nreturn null;",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
